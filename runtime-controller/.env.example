# runtime-controller sample environment. Copy to a protected local file before use.
RUNTIME_CONTROLLER_DATABASE_NAME=runtime_controller
RUNTIME_CONTROLLER_BIND_HOST=127.0.0.1
RUNTIME_CONTROLLER_PORT=8787
# Set a real value before exposing /v1 endpoints.
RUNTIME_CONTROLLER_BEARER_TOKEN=

# An active worker is fresh through this many seconds since its last membership
# heartbeat. Stale active rows remain stored as active but are unavailable for
# health and queue-capacity eligibility. Default: 120.
RUNTIME_CONTROLLER_WORKER_HEARTBEAT_TTL_SEC=120

# Required for worker startup; absolute path to your QMD checkout.
RUNTIME_CONTROLLER_QMD_REPO_ROOT=/path/to/qmd
RUNTIME_CONTROLLER_WORKER_ID=runtime-worker-1
RUNTIME_CONTROLLER_WORKER_VENUE=generic
RUNTIME_CONTROLLER_WORKER_CAPACITY=1
RUNTIME_CONTROLLER_WORKER_HEARTBEAT_INTERVAL_SEC=30
RUNTIME_CONTROLLER_WORKER_POLL_INTERVAL_MS=2000
RUNTIME_CONTROLLER_WORKER_LEASE_DURATION_SEC=120
