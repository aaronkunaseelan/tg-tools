[Unit]
Description=runtime-controller reference worker
After=network-online.target runtime-controller-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tools/runtime-controller
EnvironmentFile=%h/tools/tools.env
ExecStart=/usr/bin/env npm run worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
