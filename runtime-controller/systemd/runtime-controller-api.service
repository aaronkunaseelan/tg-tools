[Unit]
Description=runtime-controller HTTP API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tools/runtime-controller
EnvironmentFile=%h/tools/tools.env
ExecStart=/usr/bin/env npm run serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
