{
  "name": "runtime-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "node dist/src/cli.js",
    "migrate": "node dist/src/cli.js migrate",
    "serve": "node dist/src/apps/http-api.js",
    "reconciler": "node dist/src/apps/reconciler.js",
    "reconcile:once": "node dist/src/apps/reconciler.js --once",
    "worker": "node dist/src/apps/worker.js",
    "deps:ci": "python3 deploy/no-secret-env.py -- npm ci --ignore-scripts",
    "deps:audit": "python3 deploy/no-secret-env.py -- npm audit --omit=dev --audit-level=high",
    "deps:signatures": "python3 deploy/no-secret-env.py -- npm audit signatures --json"
  },
  "dependencies": {
    "pg": "8.20.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^12",
      "onFail": "error"
    }
  }
}
