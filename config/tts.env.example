# Replace /path/to placeholders with absolute paths for your deployment.
# ~/.config/tg-tools/tts.env (0600): TTS worker and result projector.
# The runtime controller comes from ~/tools/tools.env; Azure TTS and chat keys
# from ~/.config/agent-secrets/azure-foundry.env. Never put key values in Git.

TTS_WORKER_ID=tts-worker
TTS_WORKER_VENUE=oci
TTS_SPEECH_PROVIDER=azure
TTS_DEFAULT_VOICE=nova
TTS_TITLE_MODEL=

# Publication: private B2 origin behind the public rss-edge Worker.
TTS_RCLONE_REMOTE=ak_b2
TTS_B2_BUCKET=example-audio
TTS_API_BASE_URL=https://rss.example.test
TTS_API_TOKEN=
TTS_PUBLIC_BASE_URL=https://rss.example.test
TTS_FEED_URL=https://rss.example.test/tts/podcast.xml
TTS_FEED_TITLE=Example TTS

# Required endpoints and key commands: no account defaults.
# Replace example resource names; API key values are optional when using key commands.
TTS_AZURE_TTS_BASE_URL=https://speech.example.test
TTS_AZURE_TTS_API_KEY=
TTS_AZURE_TTS_KEY_CMD=az cognitiveservices account keys list --only-show-errors -g example-group -n example-speech --query key1 -o tsv
TTS_AZURE_CHAT_BASE_URL=https://chat.example.test/openai/v1
TTS_AZURE_CHAT_API_KEY=
TTS_AZURE_CHAT_KEY_CMD=az cognitiveservices account keys list --only-show-errors -g example-group -n example-chat --query key1 -o tsv

# When set, staged sources outside this root are refused.
# TTS_STAGING_ROOT=/path/to/home/.local/share/tg-tools/source-staging
TTS_WORK_DIR=/path/to/home/.local/share/tg-tools/tts/work
# x-tts reader role map (writer, reviewer, notes).
TTS_PI_ROLES_FILE=/path/to/home/.config/tg-tools/model-roles/tts-notes-<sha256>.json

TG_TOOLS_PROGRESS_ENABLED=1
