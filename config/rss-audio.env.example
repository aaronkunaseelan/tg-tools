# Replace /path/to placeholders with absolute paths for your deployment.
# ~/.config/tg-tools/rss-audio.env (0600): rss-audio workers and the rss gateway adapter.
# The runtime controller comes from ~/tools/tools.env (RUNTIME_CONTROLLER_API_URL,
# RUNTIME_CONTROLLER_BEARER_TOKEN); Azure transcription from
# ~/.config/agent-secrets/azure-openai-transcription.env.

# Bot API token for downloading Telegram files (same bot as gateway-rss).
RSS_AUDIO_BOT_TOKEN=

# rss-edge Worker: feed API, public audio and feed URLs.
RSS_AUDIO_BASE_URL=https://rss.example.test
RSS_AUDIO_API_TOKEN=
RSS_AUDIO_B2_BUCKET=example-audio

# Source routes. No defaults: a missing route is a startup error, never a fallback.
RSS_AUDIO_MULLVAD_PROXY=http://127.0.0.1:8888
RSS_AUDIO_MULLVAD_CONTROL_URL=http://127.0.0.1:8000
RSS_AUDIO_MULLVAD_CONTROL_TOKEN=
RSS_AUDIO_MAC_SSH=
RSS_AUDIO_MAC_YTDLP_PATH=/path/to/bin/yt-dlp
RSS_AUDIO_YTDLP_BIN=/path/to/home/.local/bin/yt-dlp
RSS_AUDIO_YTDLP_FORMAT=ba
RSS_AUDIO_YTDLP_REMOTE_COMPONENTS=

# Episode enrichment: Pi role map for transcript topics and mentions.
TTS_PI_ROLES_FILE=/path/to/home/.config/tg-tools/model-roles/rss-transcript-<sha256>.json

TG_TOOLS_PROGRESS_ENABLED=1
