# ~/.config/tg-tools/meeting-summary.env (0600): meeting-summary workers and gateway adapter.
# The runtime controller comes from ~/tools/tools.env; summaries use the
# openai-codex OAuth login in ~/.pi/agent/auth.json.

MEETING_SUMMARY_DATABASE_URL=
MEETING_SUMMARY_SUMMARY_MODEL=gpt-5.4-mini
MEETING_SUMMARY_RUNTIME_WORKER_VENUE=oci

# Optional overrides (defaults shown)
# MEETING_SUMMARY_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# MEETING_SUMMARY_TRANSCRIBE_JOBS=3
# MEETING_SUMMARY_MAX_AUDIO_DURATION_SEC=7200
# MEETING_SUMMARY_CHUNK_SECONDS=600
# MEETING_SUMMARY_SUMMARY_TIMEOUT_SEC=180
# MEETING_SUMMARY_STATE_DIR=~/.local/share/meeting-summary
# MEETING_SUMMARY_RETENTION_DAYS=7
# MEETING_SUMMARY_RUNTIME_WORKER_CAPACITY=1
# MEETING_SUMMARY_RUNTIME_SUPPORTED_PROFILES=cpu_media
# MEETING_SUMMARY_RUNTIME_CLAIM_WORKLOAD_TYPES=meeting_summary
# MEETING_SUMMARY_RUNTIME_ALLOWED_QUEUE_CLASSES=foreground,background,ops
# MEETING_SUMMARY_RUNTIME_QUEUE_PREFERENCE=foreground,background,ops
# MEETING_SUMMARY_RUNTIME_LEASE_DURATION_SEC=300
# MEETING_SUMMARY_RUNTIME_HEARTBEAT_INTERVAL_SEC=30
# MEETING_SUMMARY_RUNTIME_RESULT_POLL_INTERVAL_SEC=5
