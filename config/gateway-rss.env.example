# ~/.config/tg-tools/gateway-rss.env (0600): the rss-audio bot gateway.
# Serves the manifests whose botIdentity is rss-audio (rss-audio, tts).
# TELEGRAM_API_ID/HASH come from ~/.config/agent-secrets/credentials.env.

TG_GATEWAY_BOT_IDENTITY=rss-audio
TG_GATEWAY_BOT_USERNAME=
# Name of the variable that holds the bot token (here: from rss-audio.env).
TG_GATEWAY_BOT_TOKEN_ENV=RSS_AUDIO_BOT_TOKEN
TG_GATEWAY_DEPLOYMENT_MODE=production
TG_GATEWAY_ALLOWED_CHAT_ID=
TG_GATEWAY_ALLOWED_USER_IDS=
# Route binding names come from the manifests' route selectors.
TG_GATEWAY_ROUTE_BINDINGS_JSON={"rss_chat_id": 0, "rss_publish_thread_id": 0, "rss_transcribe_thread_id": 0, "tts_chat_id": 0, "tts_thread_id": 0, "x_tts_thread_id": 0}

TG_TOOLS_PROGRESS_ENABLED=1
TG_GATEWAY_PROGRESS_WORKLOADS=rss_publish,tts_synthesize,x_tts_explain
