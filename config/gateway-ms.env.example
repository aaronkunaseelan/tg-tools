# ~/.config/tg-tools/gateway-ms.env (0600): the meeting-summary bot gateway.
# TELEGRAM_API_ID/HASH come from ~/.config/agent-secrets/credentials.env.

TG_GATEWAY_BOT_IDENTITY=meeting-summary
TG_GATEWAY_BOT_USERNAME=
TG_GATEWAY_BOT_TOKEN_ENV=MEETING_SUMMARY_BOT_TOKEN
MEETING_SUMMARY_BOT_TOKEN=
TG_GATEWAY_DEPLOYMENT_MODE=production
TG_GATEWAY_ALLOWED_CHAT_ID=
TG_GATEWAY_ALLOWED_USER_IDS=
TG_GATEWAY_ROUTE_BINDINGS_JSON={"meeting_chat_id": 0, "meeting_thread_id": 0}
